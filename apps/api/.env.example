NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://taskflow:taskflow@localhost:5432/taskflow

JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
AUTH_MANAGER_INVITE_CODE=
AUTH_ADMIN_INVITE_CODE=
ASSISTANT_OPENAI_API_KEY=
ASSISTANT_OPENAI_MODEL=gpt-4o-mini
ASSISTANT_OPENAI_BASE_URL=https://api.openai.com/v1
ASSISTANT_DAILY_LIMIT=25
ASSISTANT_MAX_OUTPUT_TOKENS=350
ASSISTANT_LLM_TIMEOUT_MS=15000
ASSISTANT_TEMPERATURE=0.2

# Comma-separated origins. Required in production.
CORS_ORIGINS=http://localhost:3002

# Global API throttling
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Auth endpoints throttling
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=10
