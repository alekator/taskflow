generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  USER
}

enum WorkspaceMemberRole {
  ADMIN
  MEMBER
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum BillingProvider {
  NONE
  STRIPE
}

enum WorkspaceSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum AttachmentStatus {
  PENDING
  AVAILABLE
  DELETED
}

enum AsyncJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum ProjectRole {
  OWNER
  MANAGER
  MEMBER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  defaultWorkspaceId String?

  refreshTokenHash String?
  refreshJtiHash String?
  failedLoginAttempts Int @default(0)
  lockedUntil DateTime?

  defaultWorkspace Workspace? @relation("UserDefaultWorkspace", fields: [defaultWorkspaceId], references: [id], onDelete: SetNull)
  projectsOwned  Project[]       @relation("ProjectOwner")
  tasksAssigned  Task[]          @relation("TaskAssignee")
  projectMembers ProjectMember[]
  workspaceMembers WorkspaceMember[]
  auditLogs      AuditLog[]
  idempotencyRecords IdempotencyRecord[]
  assistantMessages AssistantMessage[]
  invitationsSent WorkspaceInvitation[] @relation("WorkspaceInvitationSender")
  taskAttachmentsUploaded TaskAttachment[]
  projectAttachmentsUploaded ProjectAttachment[]
  notificationReceipts NotificationReceipt[]

  @@index([defaultWorkspaceId])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]
  usersWithDefault User[] @relation("UserDefaultWorkspace")
  workspaceMembers WorkspaceMember[]
  invitations WorkspaceInvitation[]
  billing WorkspaceBilling?
}

model WorkspaceMember {
  id          String              @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceMemberRole @default(MEMBER)
  createdAt   DateTime            @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model WorkspaceInvitation {
  id              String                    @id @default(cuid())
  workspaceId     String
  email           String
  role            WorkspaceMemberRole       @default(MEMBER)
  invitedByUserId String
  status          WorkspaceInvitationStatus @default(PENDING)
  tokenHash       String                    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("WorkspaceInvitationSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, email, status])
  @@index([email])
  @@index([expiresAt])
}

model WorkspaceBilling {
  id                     String                      @id @default(cuid())
  workspaceId            String                      @unique
  provider               BillingProvider             @default(NONE)
  providerCustomerId     String?                     @unique
  providerSubscriptionId String?
  status                 WorkspaceSubscriptionStatus @default(TRIALING)
  planCode               String                      @default("free")
  seats                  Int                         @default(1)
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean                     @default(false)
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  workspace Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  events    WorkspaceBillingEvent[]

  @@index([workspaceId, status])
  @@index([provider, providerSubscriptionId])
}

model WorkspaceBillingEvent {
  id                 String   @id @default(cuid())
  workspaceBillingId String
  source             String
  type               String
  externalEventId    String
  idempotencyKey     String?
  payload            Json?
  processedAt        DateTime?
  createdAt          DateTime @default(now())

  workspaceBilling WorkspaceBilling @relation(fields: [workspaceBillingId], references: [id], onDelete: Cascade)

  @@unique([workspaceBillingId, externalEventId])
  @@unique([workspaceBillingId, idempotencyKey])
  @@index([workspaceBillingId, createdAt])
  @@index([source, type])
}

model Project {
  id          String  @id @default(cuid())
  name        String
  description String?
  version     Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  ownerId String
  owner   User   @relation("ProjectOwner", fields: [ownerId], references: [id])

  tasks   Task[]
  attachments ProjectAttachment[]
  members ProjectMember[]

  @@index([workspaceId])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  TESTING
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  order       Int          @default(0)
  version     Int          @default(1)
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  roadmap    TaskRoadmap?
  attachments TaskAttachment[]
}

model TaskRoadmap {
  id        String   @id @default(cuid())
  taskId    String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  action     String
  entityType String?
  entityId   String?
  projectId  String?
  actorUserId String?
  requestId  String?
  ip         String?
  userAgent  String?
  prevHash   String?
  hash       String?
  payload    Json?

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
  @@index([entityType, entityId])
  @@index([projectId])
  @@index([actorUserId])
  @@index([requestId])
  @@index([prevHash])
  @@index([hash])
  notificationReceipts NotificationReceipt[]
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

model IdempotencyRecord {
  id          String            @id @default(cuid())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  actorUserId String
  method      String
  path        String
  key         String
  requestHash String
  status      IdempotencyStatus @default(IN_PROGRESS)
  statusCode  Int?
  responseBody Json?

  actorUser User @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@unique([actorUserId, method, path, key])
  @@index([createdAt])
  @@index([actorUserId])
}

enum AssistantMessageRole {
  USER
  ASSISTANT
}

enum AssistantMessageMode {
  BASIC
  LLM
}

model AssistantMessage {
  id        String               @id @default(cuid())
  userId    String
  role      AssistantMessageRole
  mode      AssistantMessageMode
  message   String
  metadata  Json?
  createdAt DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

model TaskAttachment {
  id             String           @id @default(cuid())
  taskId         String
  uploadedByUserId String
  fileName       String
  mimeType       String
  sizeBytes      Int
  storageProvider String
  objectKey      String           @unique
  status         AttachmentStatus @default(PENDING)
  uploadTokenHash String?
  uploadedAt     DateTime?
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  task           Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedByUser User             @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)

  @@index([taskId, status])
  @@index([uploadedByUserId, createdAt])
  @@index([createdAt])
}

model ProjectAttachment {
  id               String           @id @default(cuid())
  projectId        String
  uploadedByUserId String
  fileName         String
  mimeType         String
  sizeBytes        Int
  storageProvider  String
  objectKey        String           @unique
  status           AttachmentStatus @default(PENDING)
  uploadTokenHash  String?
  uploadedAt       DateTime?
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([uploadedByUserId, createdAt])
  @@index([createdAt])
}

model AsyncJob {
  id          String         @id @default(cuid())
  type        String
  status      AsyncJobStatus @default(PENDING)
  payload     Json
  attempts    Int            @default(0)
  maxAttempts Int            @default(5)
  runAt       DateTime       @default(now())
  lastError   String?
  lockedAt    DateTime?
  lockedBy    String?
  processedAt DateTime?
  dedupeKey   String?        @unique
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, runAt])
  @@index([type, status])
}

model NotificationReceipt {
  id         String   @id @default(cuid())
  userId     String
  auditLogId String
  readAt     DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLog AuditLog @relation(fields: [auditLogId], references: [id], onDelete: Cascade)

  @@unique([userId, auditLogId])
  @@index([userId, readAt])
  @@index([auditLogId])
}
