NODE_ENV=production
PORT=3001

# Matches the default postgres service in docker-compose.prod.yml.
# If you change the postgres credentials there, update this URL to match.
DATABASE_URL=postgresql://taskflow:taskflow@postgres:5432/taskflow

# Replace both secrets before any public deployment.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret

AUTH_MANAGER_INVITE_CODE=
AUTH_ADMIN_INVITE_CODE=

# Set this to your public origin (for example: https://taskflow.example.com).
CORS_ORIGINS=http://localhost

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=10

# Optional assistant settings
ASSISTANT_OPENAI_API_KEY=
ASSISTANT_OPENAI_MODEL=gpt-4o-mini
ASSISTANT_OPENAI_BASE_URL=https://api.openai.com/v1
ASSISTANT_DAILY_LIMIT=25
ASSISTANT_MAX_OUTPUT_TOKENS=350
ASSISTANT_LLM_TIMEOUT_MS=15000
ASSISTANT_TEMPERATURE=0.2

